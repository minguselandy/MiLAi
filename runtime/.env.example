# Copy to .env, replace every placeholder, then export it before running MiLAi.
# Never commit .env. These values are development examples, not usable secrets.
MILAI_POSTGRES_PORT=15432
MILAI_POSTGRES_DB=milai
MILAI_OWNER_DB_PASSWORD=replace-with-random-owner-password
MILAI_API_DB_PASSWORD=replace-with-random-api-password
MILAI_STEWARD_DB_PASSWORD=replace-with-random-steward-password
MILAI_WORKER_DB_PASSWORD=replace-with-random-worker-password
MILAI_AUDIT_DB_PASSWORD=replace-with-random-audit-password

MILAI_DATABASE_URL=postgresql://milai_api:replace-with-random-api-password@127.0.0.1:15432/milai
MILAI_STEWARD_DATABASE_URL=postgresql://milai_steward:replace-with-random-steward-password@127.0.0.1:15432/milai
MILAI_WORKER_DATABASE_URL=postgresql://milai_worker:replace-with-random-worker-password@127.0.0.1:15432/milai
MILAI_MIGRATION_DATABASE_URL=postgresql://milai_owner:replace-with-random-owner-password@127.0.0.1:15432/milai
MILAI_AUDIT_DATABASE_URL=postgresql://milai_audit:replace-with-random-audit-password@127.0.0.1:15432/milai
MILAI_BLOB_ROOT=./var/blobs
MILAI_TENANT_ID=11111111-1111-4111-8111-111111111111
MILAI_LOCAL_ACTOR_ID=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
MILAI_API_TOKEN=replace-with-at-least-32-random-characters
MILAI_CAUSAL_TOKEN_SECRET=replace-with-a-distinct-32-character-server-secret
MILAI_AGENT_READER_TOKEN=replace-with-distinct-reader-token-at-least-32-characters
MILAI_AGENT_SUBMITTER_TOKEN=replace-with-distinct-submitter-token-at-least-32-characters
MILAI_AGENT_OPERATOR_TOKEN=replace-with-distinct-operator-token-at-least-32-characters
MILAI_AGENT_REVIEWER_TOKEN=replace-with-distinct-reviewer-token-at-least-32-characters
MILAI_DATA_MODE=SYNTHETIC_ONLY
MILAI_BLOB_ENCRYPTION=PLAINTEXT
# For AES_256_GCM only: base64 of an independent 32-byte key from a controlled provider.
# MILAI_BLOB_KEK_B64=
MILAI_BLOB_KEY_REFERENCE=local-kek-v1
MILAI_BACKUP_KEY_RECOVERY_CONFIRMED=false
MILAI_EMBEDDING_PROVIDER=deterministic_hash
MILAI_EMBEDDING_MODEL_ID=deterministic-hash-v1
MILAI_EMBEDDING_SOURCE_DIMENSIONS=16
MILAI_EMBEDDING_PROJECTION_DIMENSIONS=16
MILAI_EMBEDDING_PREWARM=true
MILAI_EMBEDDING_MAX_CONCURRENCY=4
MILAI_EMBEDDING_BATCH_SIZE=32
MILAI_RETRIEVAL_MMR_ENABLED=false
MILAI_RETRIEVAL_MMR_LAMBDA=0.8
MILAI_RETRIEVAL_RERANKER_PROVIDER=none
MILAI_RETRIEVAL_RERANKER_MODEL_ID=disabled
MILAI_RETRIEVAL_RERANKER_REVISION=disabled
MILAI_RETRIEVAL_RERANKER_POOL_SIZE=10
MILAI_RETRIEVAL_TEMPORAL_RERANKER_POOL_SIZE=20
# MILAI_RETRIEVAL_RERANKER_MODEL_PATH=/absolute/private/path/to/model
# MILAI_RETRIEVAL_RERANKER_MODEL_SHA256=64-lowercase-hex-digest
# Real provider is opt-in and local-only until the benchmark gate passes:
# MILAI_EMBEDDING_MODEL_PATH=/absolute/private/path/to/model
MILAI_BIND_HOST=127.0.0.1
MILAI_BIND_PORT=18080
MILAI_WORKER_POLL_INTERVAL_SECONDS=1
MILAI_WORKER_LEASE_SECONDS=30
MILAI_WORKER_MAX_ATTEMPTS=5
MILAI_WORKER_RETRY_DELAY_SECONDS=1
MILAI_WORKER_EVENT_LIMIT=256
MILAI_WORKER_PROJECTION_BATCH_SIZE=32
MILAI_LOG_LEVEL=INFO
MILAI_LOG_FORMAT=json
