{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "milai.dg10.attempt-ledger.snapshot.v1",
  "title": "DG-10 append-only attempt snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "sequence", "previous_entry_sha256", "entry_sha256",
    "attempt_id", "parent_attempt_id", "candidate_id", "phase", "arm",
    "case_id", "attempt_state", "planned_model_calls", "planned_mcp_calls",
    "native_request_ids", "native_mcp_request_ids", "usage",
    "provider_terminal", "mcp_terminal", "agent_terminal", "parser_terminal", "started_at",
    "provider_claimed_at", "provider_claim_digest",
    "native_completed_at", "mcp_completed_at", "finished_at", "retention_state",
    "failure_reason_code", "external_billed_cost", "self_hosted_compute_cost",
    "raw_sidecar_digest", "raw_mcp_sidecar_digest", "redacted_public_receipt_digest"
  ],
  "properties": {
    "schema": {"const": "milai.dg10.attempt-ledger.snapshot.v1"},
    "sequence": {"type": "integer", "minimum": 1},
    "previous_entry_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "entry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attempt_id": {"type": "string", "minLength": 1},
    "parent_attempt_id": {"type": ["string", "null"]},
    "candidate_id": {"type": "string", "pattern": "^candidate\\.[0-9]+(?:\\.[0-9]+)*$"},
    "phase": {"type": "string", "minLength": 1},
    "arm": {"type": ["string", "null"]},
    "case_id": {"type": "string", "minLength": 1},
    "attempt_state": {"enum": ["PLANNED", "PROVIDER_CLAIMED", "PROVIDER_ACCEPTED", "PROVIDER_TERMINAL", "FINALIZED"]},
    "planned_model_calls": {"type": "integer", "minimum": 0},
    "planned_mcp_calls": {"type": "integer", "minimum": 0},
    "native_request_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "native_mcp_request_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "cached_input_tokens", "reasoning_tokens"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "provider_terminal": {"type": ["boolean", "null"]},
    "mcp_terminal": {"type": ["boolean", "null"]},
    "agent_terminal": {"type": ["boolean", "null"]},
    "parser_terminal": {"type": ["boolean", "null"]},
    "started_at": {"type": "string", "format": "date-time"},
    "provider_claimed_at": {"type": ["string", "null"], "format": "date-time"},
    "provider_claim_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "native_completed_at": {"type": ["string", "null"], "format": "date-time"},
    "mcp_completed_at": {"type": ["string", "null"], "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "retention_state": {"enum": ["retained", "superseded", "failed", "partial"]},
    "failure_reason_code": {"enum": ["PROVIDER_REQUEST_FAILED", "PROVIDER_TERMINAL_MISSING", "AGENT_EVENT_PARSE_FAILED", "AGENT_TERMINAL_EVENT_MISSING", "AGENT_POLICY_REJECTED", "OUTPUT_SCHEMA_INVALID", "DEADLINE_EXCEEDED", "SUCCESS"]},
    "external_billed_cost": {"type": ["number", "string"], "minimum": 0},
    "self_hosted_compute_cost": {"enum": ["UNAVAILABLE_NOT_ZERO", "MEASURED"]},
    "raw_sidecar_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "raw_mcp_sidecar_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "redacted_public_receipt_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  }
}
