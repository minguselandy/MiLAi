{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milai.local/research/ospc/fixture_schema.v1.json",
  "title": "MiLAi OSPC synthetic pilot fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_id",
    "domain",
    "goal",
    "budget_tokens",
    "history",
    "stable_state",
    "constraints",
    "issue",
    "resolution",
    "annotation_version"
  ],
  "properties": {
    "fixture_id": {"type": "string", "pattern": "^OSP-[0-9]{3}$"},
    "domain": {
      "enum": ["software_project_memory", "personalized_multi_session_assistant"]
    },
    "goal": {"type": "string", "minLength": 1},
    "budget_tokens": {"type": "integer", "minimum": 1},
    "history": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "stable_state": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "annotation_version": {"const": "ospc.annotation.v1"},
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id",
        "issue_type",
        "target_claim_id",
        "status",
        "support_refs",
        "contradict_refs",
        "discharge_rule",
        "dependencies",
        "authority"
      ],
      "properties": {
        "issue_id": {"type": "string"},
        "issue_type": {
          "enum": [
            "CONFLICT",
            "MISSING_EVIDENCE",
            "SCOPE_UNCERTAIN",
            "AUTHORITY_UNCERTAIN",
            "DEPENDENCY_INVALIDATED"
          ]
        },
        "target_claim_id": {"type": "string"},
        "status": {"enum": ["OPEN", "WAITING_EVIDENCE", "WAITING_USER"]},
        "support_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "contradict_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "discharge_rule": {"type": "string", "minLength": 1},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "authority": {"enum": ["INFORMATIONAL", "ACTION_SAFE", "USER_CONFIRMED"]}
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "target_claim_id",
        "satisfies_rule",
        "scope_matches",
        "authority_matches",
        "expected_status"
      ],
      "properties": {
        "evidence_id": {"type": "string"},
        "target_claim_id": {"type": "string"},
        "satisfies_rule": {"type": "boolean"},
        "scope_matches": {"type": "boolean"},
        "authority_matches": {"type": "boolean"},
        "expected_status": {
          "enum": ["OPEN", "WAITING_EVIDENCE", "WAITING_USER", "RESOLVED"]
        }
      }
    }
  }
}
