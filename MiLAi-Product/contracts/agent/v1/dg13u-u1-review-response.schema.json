{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milai.local/contracts/agent/v1/dg13u-u1-review-response.schema.json",
  "title": "DG13U U1 independent review response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "review_scope",
    "verdict",
    "summary",
    "open_findings",
    "missing_evidence",
    "reviewed_manifest_sha256"
  ],
  "properties": {
    "schema": {
      "const": "milai.dg13u.u1-review-response.v1"
    },
    "review_scope": {
      "const": "DG13U_U1_RELEASE_BUNDLE"
    },
    "verdict": {
      "enum": [
        "PASS",
        "REVISE",
        "BLOCKED_BY_MISSING_EVIDENCE"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "reviewed_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "open_findings": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "missing_evidence": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "PASS"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "open_findings": {
            "not": {
              "contains": {
                "properties": {
                  "severity": {
                    "enum": [
                      "P0",
                      "P1"
                    ]
                  }
                },
                "required": [
                  "severity"
                ]
              }
            }
          },
          "missing_evidence": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "REVISE"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "open_findings": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "BLOCKED_BY_MISSING_EVIDENCE"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "missing_evidence": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "severity",
        "title",
        "evidence",
        "required_action"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^DG13U-U1-RV-[0-9]{3}$"
        },
        "severity": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required_action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  }
}
