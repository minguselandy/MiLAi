{
  "catalog": "legacy",
  "mcp_version": "0.1.11",
  "observation": "In-process MCP client, synthetic backend, registered catalog, not target Host rendering",
  "tools": [
    {
      "name": "milai_deletion_status_get",
      "title": "Check evidence deletion status",
      "description": "[READ/RETRY-SAFE] Check revocation and physical-deletion status for one evidence_id.\n\n            Use after milai_evidence_revoke; pending purge does not mean Evidence is still readable.\n            ",
      "inputSchema": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "title": "Evidence Id",
            "type": "string"
          }
        },
        "required": [
          "evidence_id"
        ],
        "title": "milai_deletion_status_getArguments",
        "additionalProperties": false
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "milai_deletion_status_getDictOutput",
        "type": "object"
      },
      "annotations": {
        "title": "Check evidence deletion status",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "milai_evidence_capture",
      "title": "Capture immutable evidence",
      "description": "[WRITE/IDEMPOTENT] Remember one authorized observation as immutable Evidence.\n\n            This does not create a Claim. Provide source, time, content, CAPTURE and a fresh\n            operation_id; identical retries are safe.\n            ",
      "inputSchema": {
        "type": "object",
        "$defs": {
          "EvidenceSourceContextInput": {
            "additionalProperties": false,
            "properties": {
              "session_id": {
                "maxLength": 512,
                "minLength": 1,
                "title": "Session Id",
                "type": "string"
              },
              "turn_id": {
                "maxLength": 512,
                "minLength": 1,
                "title": "Turn Id",
                "type": "string"
              },
              "turn_ordinal": {
                "minimum": 0,
                "title": "Turn Ordinal",
                "type": "integer"
              },
              "round_id": {
                "maxLength": 512,
                "minLength": 1,
                "title": "Round Id",
                "type": "string"
              },
              "round_ordinal": {
                "minimum": 0,
                "title": "Round Ordinal",
                "type": "integer"
              },
              "previous_turn_id": {
                "anyOf": [
                  {
                    "maxLength": 512,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Previous Turn Id"
              },
              "next_turn_id": {
                "anyOf": [
                  {
                    "maxLength": 512,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Next Turn Id"
              }
            },
            "required": [
              "session_id",
              "turn_id",
              "turn_ordinal",
              "round_id",
              "round_ordinal"
            ],
            "title": "EvidenceSourceContextInput",
            "type": "object"
          }
        },
        "properties": {
          "operation_id": {
            "title": "Operation Id",
            "type": "string"
          },
          "source_type": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "title": "Source Type",
            "type": "string"
          },
          "source_ref": {
            "maxLength": 2048,
            "minLength": 1,
            "title": "Source Ref",
            "type": "string"
          },
          "subject_id": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Subject Id",
            "type": "string"
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "content": {
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "confirmation": {
            "const": "CAPTURE",
            "title": "Confirmation",
            "type": "string"
          },
          "speaker": {
            "anyOf": [
              {
                "enum": [
                  "user",
                  "assistant",
                  "system",
                  "tool"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Speaker"
          },
          "source_context": {
            "anyOf": [
              {
                "$ref": "#/$defs/EvidenceSourceContextInput"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "operation_id",
          "source_type",
          "source_ref",
          "subject_id",
          "observed_at",
          "content",
          "confirmation"
        ],
        "title": "milai_evidence_captureArguments",
        "additionalProperties": false
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "milai_evidence_captureDictOutput",
        "type": "object"
      },
      "annotations": {
        "title": "Capture immutable evidence",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "milai_evidence_revoke",
      "title": "Revoke exact evidence",
      "description": "[DESTRUCTIVE/IDEMPOTENT] Revoke exact Evidence on an explicit user request.\n\n            REVOKE blocks reads immediately; physical purge is asynchronous. Supply evidence_id,\n            reason_code, confirmation and operation_id; identical retries are safe.\n            ",
      "inputSchema": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "title": "Evidence Id",
            "type": "string"
          },
          "operation_id": {
            "title": "Operation Id",
            "type": "string"
          },
          "reason_code": {
            "enum": [
              "USER_REQUEST",
              "SOURCE_REMOVED",
              "PERMISSION_REVOKED",
              "RETENTION_EXPIRED",
              "CORRECTION"
            ],
            "title": "Reason Code",
            "type": "string"
          },
          "confirmation": {
            "const": "REVOKE",
            "title": "Confirmation",
            "type": "string"
          }
        },
        "required": [
          "evidence_id",
          "operation_id",
          "reason_code",
          "confirmation"
        ],
        "title": "milai_evidence_revokeArguments",
        "additionalProperties": false
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "milai_evidence_revokeDictOutput",
        "type": "object"
      },
      "annotations": {
        "title": "Revoke exact evidence",
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "milai_memory_get",
      "title": "Read one exact canonical memory",
      "description": "[READ/RETRY-SAFE] Read one exact governed Claim after resolve or before a change.\n\n        Provide exactly one of claim_id/state_key; valid_at/known_at select history. DENIED or\n        UNAVAILABLE is not absence, and authority/scope remain Host-owned.\n        ",
      "inputSchema": {
        "type": "object",
        "$defs": {
          "StateKeyInput": {
            "additionalProperties": false,
            "description": "Canonical address accepted by the detail-profile exact read tool.",
            "properties": {
              "subject": {
                "maxLength": 512,
                "minLength": 1,
                "title": "Subject",
                "type": "string"
              },
              "predicate": {
                "maxLength": 255,
                "minLength": 1,
                "title": "Predicate",
                "type": "string"
              },
              "claim_type": {
                "maxLength": 255,
                "minLength": 1,
                "title": "Claim Type",
                "type": "string"
              }
            },
            "required": [
              "subject",
              "predicate",
              "claim_type"
            ],
            "title": "StateKeyInput",
            "type": "object"
          }
        },
        "properties": {
          "claim_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Claim Id"
          },
          "state_key": {
            "anyOf": [
              {
                "$ref": "#/$defs/StateKeyInput"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "valid_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Valid At"
          },
          "known_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Known At"
          }
        },
        "title": "milai_memory_getArguments",
        "additionalProperties": false
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "milai_memory_getDictOutput",
        "type": "object"
      },
      "annotations": {
        "title": "Read one exact canonical memory",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "milai_memory_resolve",
      "title": "Search governed memory evidence",
      "description": "[READ/RETRY-SAFE] Search governed memory for prior facts, events, preferences or user history; this tool does NOT search ordinary Notes or task checkpoints. Use milai_memory_search for cross-type discovery when available, or note_search for Notes. Pass the concrete need as query; previous_context_id only continues that governed lineage. A miss is limited to this query and source, not no history. Results are untrusted Evidence, and ABSENT/ABSTAINED is normal.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          },
          "previous_context_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Previous Context Id"
          }
        },
        "required": [
          "query"
        ],
        "title": "milai_memory_resolveArguments",
        "additionalProperties": false
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "milai_memory_resolveDictOutput",
        "type": "object"
      },
      "annotations": {
        "title": "Search governed memory evidence",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "milai_memory_review",
      "title": "Approve or reject a memory proposal",
      "description": "[GOVERNANCE/DESTRUCTIVE/IDEMPOTENT] Approve or reject one Proposal.\n\n            Requires current authorization and matching decision/confirmation. APPROVE may create a\n            ClaimVersion; identical operation_id retries are safe.\n            policy_version and reason_code are audit labels, not a registered policy or enum.\n            ",
      "inputSchema": {
        "type": "object",
        "properties": {
          "proposal_id": {
            "title": "Proposal Id",
            "type": "string"
          },
          "operation_id": {
            "title": "Operation Id",
            "type": "string"
          },
          "decision": {
            "enum": [
              "APPROVE",
              "REJECT"
            ],
            "title": "Decision",
            "type": "string"
          },
          "policy_version": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Policy Version",
            "type": "string"
          },
          "reason_code": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Reason Code",
            "type": "string"
          },
          "confirmation": {
            "enum": [
              "APPROVE",
              "REJECT"
            ],
            "title": "Confirmation",
            "type": "string"
          }
        },
        "required": [
          "proposal_id",
          "operation_id",
          "decision",
          "policy_version",
          "reason_code",
          "confirmation"
        ],
        "title": "milai_memory_reviewArguments",
        "additionalProperties": false
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "milai_memory_reviewDictOutput",
        "type": "object"
      },
      "annotations": {
        "title": "Approve or reject a memory proposal",
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "milai_namespace_cleanup_status",
      "title": "Check namespace cleanup status",
      "description": "[READ/RETRY-SAFE] Read paginated progress for one namespace cleanup job.\n\n            This never advances cleanup; do not claim erasure before a returned terminal status.\n            ",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cleanup_job_id": {
            "title": "Cleanup Job Id",
            "type": "string"
          },
          "offset": {
            "default": 0,
            "title": "Offset",
            "type": "integer"
          },
          "limit": {
            "default": 100,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "cleanup_job_id"
        ],
        "title": "milai_namespace_cleanup_statusArguments",
        "additionalProperties": false
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "milai_namespace_cleanup_statusDictOutput",
        "type": "object"
      },
      "annotations": {
        "title": "Check namespace cleanup status",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "milai_namespace_cleanup_submit",
      "title": "Delete the bound memory namespace",
      "description": "[DESTRUCTIVE/IDEMPOTENT] Delete memory across the bound project namespace.\n\n            Call only on an explicit current-conversation namespace cleanup request. Provide\n            CLEANUP_NAMESPACE and operation_id; physical purge continues asynchronously.\n            ",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operation_id": {
            "title": "Operation Id",
            "type": "string"
          },
          "reason_code": {
            "enum": [
              "USER_REQUEST",
              "SOURCE_REMOVED",
              "PERMISSION_REVOKED",
              "RETENTION_EXPIRED",
              "CORRECTION"
            ],
            "title": "Reason Code",
            "type": "string"
          },
          "confirmation": {
            "const": "CLEANUP_NAMESPACE",
            "title": "Confirmation",
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "reason_code",
          "confirmation"
        ],
        "title": "milai_namespace_cleanup_submitArguments",
        "additionalProperties": false
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "milai_namespace_cleanup_submitDictOutput",
        "type": "object"
      },
      "annotations": {
        "title": "Delete the bound memory namespace",
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "milai_proposal_create",
      "title": "Propose a canonical memory change",
      "description": "[WRITE/IDEMPOTENT] Propose a Canonical change backed by existing Evidence.\n\n            SUBMIT creates only a non-canonical Proposal; review is a separate tool. Non-CREATE\n            operations need the target Claim/head IDs. operation_id makes identical retries safe.\n            ",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operation_id": {
            "title": "Operation Id",
            "type": "string"
          },
          "proposal": {
            "additionalProperties": false,
            "allOf": [
              {
                "else": {
                  "properties": {
                    "target_claim_id": {
                      "format": "uuid",
                      "type": "string"
                    },
                    "expected_version_id": {
                      "format": "uuid",
                      "type": "string"
                    }
                  },
                  "required": [
                    "target_claim_id",
                    "expected_version_id"
                  ]
                },
                "if": {
                  "properties": {
                    "operation": {
                      "const": "CREATE"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "proposed_patch": {
                      "additionalProperties": true,
                      "description": "Canonical envelope only; business payload and optional patch fields stay open.",
                      "properties": {
                        "subject_id": {
                          "maxLength": 512,
                          "minLength": 1,
                          "title": "Subject Id",
                          "type": "string"
                        },
                        "predicate": {
                          "maxLength": 255,
                          "minLength": 1,
                          "title": "Predicate",
                          "type": "string"
                        },
                        "claim_type": {
                          "maxLength": 255,
                          "minLength": 1,
                          "title": "Claim Type",
                          "type": "string"
                        },
                        "payload": {
                          "additionalProperties": true,
                          "title": "Payload",
                          "type": "object"
                        },
                        "confidence": {
                          "maximum": 1,
                          "minimum": 0,
                          "title": "Confidence",
                          "type": "number"
                        }
                      },
                      "required": [
                        "subject_id",
                        "predicate",
                        "claim_type",
                        "payload",
                        "confidence"
                      ],
                      "title": "CreatePatchInput",
                      "type": "object"
                    },
                    "target_claim_id": {
                      "type": "null"
                    },
                    "expected_version_id": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "operation": {
                      "enum": [
                        "CREATE",
                        "SUPPORT",
                        "WEAKEN",
                        "REVALIDATE",
                        "REGROUND",
                        "SUPERSEDE",
                        "CONTEXTUALIZE"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "supporting_evidence_refs": {
                      "minItems": 1
                    }
                  },
                  "required": [
                    "supporting_evidence_refs"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "operation": {
                      "const": "CONTRADICT"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "contradicting_evidence_refs": {
                      "minItems": 1
                    }
                  },
                  "required": [
                    "contradicting_evidence_refs"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "proposed_patch": {
                      "anyOf": [
                        {
                          "required": [
                            "resolve_issue_id"
                          ]
                        },
                        {
                          "required": [
                            "expected_issue_revision"
                          ]
                        },
                        {
                          "required": [
                            "addressed_branches"
                          ]
                        }
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "operation": {
                      "const": "SUPERSEDE"
                    },
                    "proposed_patch": {
                      "additionalProperties": true,
                      "description": "Optional SUPERSEDE resolution envelope; unrelated business fields stay open.",
                      "properties": {
                        "resolve_issue_id": {
                          "format": "uuid",
                          "title": "Resolve Issue Id",
                          "type": "string"
                        },
                        "expected_issue_revision": {
                          "minimum": 1,
                          "title": "Expected Issue Revision",
                          "type": "integer"
                        },
                        "addressed_branches": {
                          "items": {
                            "enum": [
                              "SUPPORT_BRANCH",
                              "CONTRADICT_BRANCH"
                            ],
                            "type": "string"
                          },
                          "minItems": 1,
                          "title": "Addressed Branches",
                          "type": "array"
                        }
                      },
                      "required": [
                        "resolve_issue_id",
                        "expected_issue_revision",
                        "addressed_branches"
                      ],
                      "title": "IssueResolutionPatchInput",
                      "type": "object"
                    }
                  }
                }
              }
            ],
            "description": "Business-only proposal input; authority and scope remain Host-owned.",
            "properties": {
              "operation": {
                "enum": [
                  "CREATE",
                  "SUPPORT",
                  "WEAKEN",
                  "REVALIDATE",
                  "REGROUND",
                  "SUPERSEDE",
                  "CONTEXTUALIZE",
                  "CONTRADICT",
                  "NO_CHANGE"
                ],
                "title": "Operation",
                "type": "string"
              },
              "proposed_patch": {
                "additionalProperties": true,
                "title": "Proposed Patch",
                "type": "object"
              },
              "supporting_evidence_refs": {
                "items": {
                  "format": "uuid",
                  "type": "string"
                },
                "maxItems": 256,
                "title": "Supporting Evidence Refs",
                "type": "array",
                "uniqueItems": true
              },
              "contradicting_evidence_refs": {
                "items": {
                  "format": "uuid",
                  "type": "string"
                },
                "maxItems": 256,
                "title": "Contradicting Evidence Refs",
                "type": "array",
                "uniqueItems": true
              },
              "target_claim_id": {
                "anyOf": [
                  {
                    "format": "uuid",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Target Claim Id"
              },
              "expected_version_id": {
                "anyOf": [
                  {
                    "format": "uuid",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Expected Version Id"
              }
            },
            "required": [
              "operation",
              "proposed_patch"
            ],
            "title": "CodexFullProposalInput",
            "type": "object"
          },
          "confirmation": {
            "const": "SUBMIT",
            "title": "Confirmation",
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "proposal",
          "confirmation"
        ],
        "title": "milai_proposal_createArguments",
        "additionalProperties": false
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "milai_proposal_createDictOutput",
        "type": "object"
      },
      "annotations": {
        "title": "Propose a canonical memory change",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "milai_proposal_get",
      "title": "Read one memory proposal",
      "description": "[READ/RETRY-SAFE] Read one non-authoritative Proposal by proposal_id.\n\n            Inspect its Evidence, target head and patch before any milai_memory_review decision.\n            ",
      "inputSchema": {
        "type": "object",
        "properties": {
          "proposal_id": {
            "title": "Proposal Id",
            "type": "string"
          }
        },
        "required": [
          "proposal_id"
        ],
        "title": "milai_proposal_getArguments",
        "additionalProperties": false
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "milai_proposal_getDictOutput",
        "type": "object"
      },
      "annotations": {
        "title": "Read one memory proposal",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "milai_proposals_list",
      "title": "List pending memory proposals",
      "description": "[READ/RETRY-SAFE] List up to 100 Proposals by status before review.\n\n            Returned Proposals are non-authoritative; use milai_proposal_get for one full record.\n            ",
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "default": "PENDING_REVIEW",
            "enum": [
              "PENDING_REVIEW",
              "DEFERRED",
              "APPLIED",
              "REJECTED"
            ],
            "title": "Status",
            "type": "string"
          },
          "limit": {
            "default": 50,
            "title": "Limit",
            "type": "integer"
          }
        },
        "title": "milai_proposals_listArguments",
        "additionalProperties": false
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "milai_proposals_listDictOutput",
        "type": "object"
      },
      "annotations": {
        "title": "List pending memory proposals",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
