# Dedicated MCP environment only. Do not source the Runtime .env here.
MILAI_MCP_AUTH_MODE=aigcit
MILAI_AIGCIT_ACCESS_MODE=authenticated_private
MILAI_MCP_HTTP_PUBLIC_BASE_URL=https://milai.aigcit.com:7960
MILAI_AIGCIT_ISSUER=https://auth.aigcit.com
MILAI_AIGCIT_BINDINGS_FILE=/etc/milai-aigcit/bindings.json
# Pair with --catalog compact-memory-v1: union of all selected tool branches.
MILAI_AIGCIT_ENABLED_SCOPES="milai.memory.read milai.state.read milai.state.write milai.evidence.capture milai.evidence.revoke milai.note.read milai.note.write milai.note.delete milai.evidence.read"
# Private mode uses this as a stable namespace, not a shared user project.
MILAI_AGENT_SCOPE_JSON={"project_ids":["REPLACE_WITH_STABLE_NAMESPACE"]}
MILAI_CODEX_TASK_REF=REPLACE_WITH_TRUSTED_TASK_REFERENCE
MILAI_BASE_URL=http://127.0.0.1:28180
MILAI_CODEX_DATA_CLASSIFICATION=PERSONAL
# Deliver these four Runtime role credentials separately, protected from other users.
# Do not add MILAI_CODEX_TOKEN, MILAI_CODEX_PRINCIPAL_ID, MILAI_OAUTH_DB or a registry.
MILAI_AGENT_READER_TOKEN=REPLACE_WITH_DEDICATED_RUNTIME_READER_CREDENTIAL
MILAI_AGENT_SUBMITTER_TOKEN=REPLACE_WITH_DEDICATED_RUNTIME_SUBMITTER_CREDENTIAL
MILAI_AGENT_REVIEWER_TOKEN=REPLACE_WITH_DEDICATED_RUNTIME_REVIEWER_CREDENTIAL
MILAI_AGENT_OPERATOR_TOKEN=REPLACE_WITH_DEDICATED_RUNTIME_OPERATOR_CREDENTIAL
