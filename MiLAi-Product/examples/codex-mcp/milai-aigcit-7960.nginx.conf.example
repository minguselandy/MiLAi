# STAGED ONLY. Obtain and verify a trusted certificate before installing this site.
# AIGCIT is external: never proxy local authorize/token/register/consent endpoints.
# Requires ngx_http_limit_req_module; verify the selected binary before rollout.
limit_req_zone $binary_remote_addr zone=milai_aigcit:10m rate=10r/s;
log_format milai_aigcit_safe '$remote_addr [$time_local] "$request_method $uri" '
                           '$status $body_bytes_sent $request_time';
server {
    listen 7960 ssl;
    server_name milai.aigcit.com;
    ssl_certificate /etc/letsencrypt/live/milai.aigcit.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/milai.aigcit.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    access_log /var/log/nginx/milai-aigcit.access.log milai_aigcit_safe;
    # Nginx error messages can include raw query strings; don't log request errors.
    error_log /var/log/nginx/milai-aigcit.error.log emerg;
    if ($http_host != milai.aigcit.com:7960) { return 421; }
    error_page 497 =400 @plaintext_rejected;
    location @plaintext_rejected { return 400; }
    client_max_body_size 4m;
    client_header_timeout 15s;
    client_body_timeout 30s;
    keepalive_timeout 65s;
    send_timeout 300s;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host milai.aigcit.com:7960;
    proxy_set_header Origin $http_origin;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-Proto "";
    proxy_set_header X-Forwarded-Port "";
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Agent-Id "";
    proxy_set_header X-User-Id "";
    proxy_set_header X-Principal-Id "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 300s;
    proxy_send_timeout 30s;
    proxy_buffering off;
    proxy_request_buffering on;
    proxy_cache off;
    proxy_redirect off;
    proxy_next_upstream off;
    location = /mcp {
        limit_req zone=milai_aigcit burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:7969;
    }
    location ~ ^/(healthz|readyz|\.well-known/oauth-protected-resource/mcp)$ {
        proxy_pass http://127.0.0.1:7969;
    }
    location / { return 404; }
}
