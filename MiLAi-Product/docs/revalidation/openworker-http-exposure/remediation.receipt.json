  "debt_id": "openworker-http-auth-exposure",
  "decision": {
    "rationale": "The executable now validates the listen target before adapter initialization, accepts only explicit loopback, RFC1918, or IPv6 ULA literals, selects the matching IPv4/IPv6 server family, and rejects wildcard, hostname, multicast, and public targets. Exact Bearer auth remains fail-closed before parsing. The startup token is explicitly process-lifetime: file replacement does not mutate a live adapter, while controlled restart rejects the old capability and accepts the replacement.",
    "state": "FIXED"
  },
