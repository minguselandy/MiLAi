{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milai.local/research/ospc/output_schema.v1.json",
  "title": "MiLAi OSPC normalized compression output",
  "type": "object",
  "required": [
    "status",
    "goal",
    "constraints",
    "stable_state",
    "open_issues",
    "evidence_pointers",
    "evicted_recoverable",
    "compression_trace"
  ],
  "properties": {
    "status": {"enum": ["OK", "INFEASIBLE_UNDER_BUDGET"]},
    "goal": {"type": "string"},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "stable_state": {"type": "array"},
    "open_issues": {"type": "array", "items": {"type": "object"}},
    "evidence_pointers": {"type": "array", "items": {"type": "string"}},
    "evicted_recoverable": {"type": "array"},
    "compression_trace": {
      "type": "object",
      "required": ["schema", "method_code", "recovery_calls", "fallback_count"]
    }
  },
  "additionalProperties": true
}
